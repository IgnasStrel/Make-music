{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "build" }
    }
  ],
  "routes": [
    {
      "src": "/",
      "status": 307,
      "headers": { "Location": "/html/index.html" }
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
